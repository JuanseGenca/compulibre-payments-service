// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionStatus {
  PENDING
  PAID
  REJECTED
}

enum PayoutStatus {
  PROCESSING
  COMPLETED
  REJECTED
}

enum TicketStatus {
  OPEN
  REVIEWING
  CLOSED
}

model Account {
  clerk_user_id     String     @id @unique
  balance           Float      @default(0.0)
  payouts           Payout[]
}

model Transaction {
  id                       String            @id @default(uuid())
  external_order_reference String
  amount                   Float
  currency                 String            @default("ARS")
  status                   TransactionStatus @default(PENDING)
  created_at               DateTime          @default(now())
  buyerId                  String
  payment_method           String?
  items                    TransactionItem[]
  buyerAddress             String
  buyerCodigoPostal        Int
}

model TransactionItem {
  id            String      @id @default(uuid())
  sellerId      String
  productId     String
  quantity      Int
  name          String
  unit_price    Float

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Payout {
  id              String       @id @default(uuid())
  account_id      String
  amount          Float
  destination_cbu String
  status          PayoutStatus @default(PROCESSING)
  
  account         Account  @relation(fields: [account_id], references: [clerk_user_id])
}

model SupportTicket {
  id              String       @id @default(cuid())
  
  buyerId         String   
  transactionId   String   
  
  subject         String
  message         String       @db.Text
  
  status          TicketStatus @default(OPEN)
  
  createdAt       DateTime     @default(now())
}
