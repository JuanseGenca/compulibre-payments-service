# ---------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/compulibre_payments?schema=public"

# ---------------------------------------------------------------------------
# Mercado Pago SDK Configuration
# ---------------------------------------------------------------------------
# Sandbox / Production Access Token from Mercado Pago Developers
MP_ACCESS_TOKEN="TEST-..."

# Public URL where Mercado Pago will send IPN / Webhook notifications
WEBHOOK_URL="https://your-domain.com/api/webhooks/mercadopago"

# ---------------------------------------------------------------------------
# Clerk Authentication & RBAC
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ---------------------------------------------------------------------------
# Microservices & Inter-service Security (API Keys)
# ---------------------------------------------------------------------------
# Key used by this Payments service when notifying Buyer and Seller services
PAYMENTS_API_KEY="your-payments-api-key"

# Key expected from the Buyer App when initializing a checkout
BUYER_API_KEY="your-buyer-api-key"

# Key expected from the Analytics Dashboard when querying /api/analytics/summary
ANALYTICS_API_KEY="your-analytics-api-key"

# Key expected when querying administrative control-panel endpoints
SUPERADMIN_API_KEY="your-superadmin-api-key"

# ---------------------------------------------------------------------------
# External Microservice URLs
# ---------------------------------------------------------------------------
BUYER_APP_URL="http://localhost:3000"
SELLER_APP_URL="http://localhost:3002"